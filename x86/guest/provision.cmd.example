@echo off
rem Copy to provision.cmd to have install.sh bake software into the golden. Runs once, elevated,
rem at the first logon with network up; everything it prints lands in C:\egg-provision.txt.
rem Example, Fusion. The streaming "Fusion Client Downloader" fails inside the egg
rem (TLS alert from its bundled Python); the full Admin Install package works. Its silent
rem switches are not verified here: run it once by hand to learn them, then fill them in.
curl.exe -L -o "%TEMP%\FusionAdminInstall.exe" "https://dl.appstreaming.autodesk.com/production/installers/Fusion%%20Admin%%20Install.exe"
"%TEMP%\FusionAdminInstall.exe" --quiet

rem NVIDIA driver, for a golden built with --gpu nvidia (or given a card later, README section 6).
rem Pick the package for the card from nvidia.com (GeForce/RTX for a workstation card, the Data
rem Center driver for a T4); -s is silent, -noreboot leaves the restart to the lane's own shutdown.
rem curl.exe -L -o "%TEMP%\nvidia.exe" "https://us.download.nvidia.com/.../<version>-desktop-win10-win11-64bit-international-dch-whql.exe"
rem "%TEMP%\nvidia.exe" -s -noreboot -clean
rem (echo nvidia=%ERRORLEVEL%>> "%P%")
